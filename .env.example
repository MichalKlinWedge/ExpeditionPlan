# Skopiuj do `.env.local` (nigdy do repozytorium) i uzupełnij.
# Klucze serwerowe (AI, Geoapify, ORS, SMTP) czyta tylko serwer weba: lokalnie trafiają z tego pliku
# do `apps/web/.env.local` przez `scripts/sync-env.mjs` (uruchamia go `npm run web`), na produkcji
# to zmienne projektu Vercel. Nigdy do aplikacji mobilnej ani przeglądarki (bez przedrostka NEXT_PUBLIC_).

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Adres weba dla aplikacji mobilnej (paragony przez /api/receipt, knajpy). Puste = produkcja (https://expedition-plan.vercel.app).
EXPO_PUBLIC_WEB_URL=
# Tylko skrypty lokalne (seed, testy synchronizacji) — nigdy w aplikacji ani w webie:
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (packages/ai) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Puste = domyślne z packages/ai/src/providers.ts
AI_MODEL_CLAUDE=
AI_MODEL_GEMINI=
AI_MODEL_OPENAI=
# Kto może używać AI i wyszukiwania miejsc w webie (e-maile po przecinku). Puste: lokalnie wszyscy, na produkcji nikt.
AI_ALLOWED_EMAILS=

# --- Miejsca i trasy ---
GEOAPIFY_API_KEY=
OPENROUTESERVICE_API_KEY=

# --- E-mail (dowolny SMTP, np. Resend jako serwer SMTP) ---
# Zaproszenia wysyłane z serwisu (`apps/web/src/lib/mail.ts`): te same dane co „Custom SMTP” w Supabase Auth (też w Vercel).
# Bez SMTP_HOST i MAIL_FROM wysyłka jest wyłączona, a zaproszenie zostaje do skopiowania.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expedition Planner <zaproszenia@twoja-domena.pl>"
# Link instalacyjny APK dla znajomych (strona EAS z kodem QR), dołączany do zaproszeń. Opcjonalny, nie jest sekretem (też w Vercel).
FRIENDS_APK_URL=
