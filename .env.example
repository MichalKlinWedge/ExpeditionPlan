# Skopiuj do `.env.local` (nigdy do repozytorium) i uzupełnij.
# Klucze dostawców AI i usług trafiają w produkcji do sekretów Edge Functions
# (`supabase secrets set …`), a nie do aplikacji ani przeglądarki.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Tylko skrypty lokalne i Edge Functions — nigdy w aplikacji:
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (packages/ai) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Puste = domyślne z packages/ai/src/providers.ts
AI_MODEL_CLAUDE=
AI_MODEL_GEMINI=
AI_MODEL_OPENAI=
# Kto może używać AI i wyszukiwania miejsc w webie (e-maile po przecinku). Puste: lokalnie wszyscy, na produkcji nikt.
AI_ALLOWED_EMAILS=

# --- Miejsca i trasy ---
GEOAPIFY_API_KEY=
OPENROUTESERVICE_API_KEY=

# --- E-mail (Resend, SMTP dla Supabase Auth) ---
RESEND_API_KEY=
