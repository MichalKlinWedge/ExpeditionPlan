{
  "expo": {
    "name": "Expedition Planner",
    "slug": "expeditionplan",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expeditionplan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.expeditionplan.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aparat służy do zdjęć w dzienniku wyjazdu.",
          "photosPermission": "Zdjęcia z galerii można dodać do dziennika wyjazdu.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97a2d101-aa3a-42ea-9502-6b9714c11975",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "extra": {
      "eas": {
        "projectId": "97a2d101-aa3a-42ea-9502-6b9714c11975"
      }
    },
    "owner": "klin.michal"
  }
}
