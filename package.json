{
  "name": "expeditionplan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "web": "npm run dev --workspace apps/web",
    "mobile": "npm run start --workspace apps/mobile",
    "supabase": "npx --yes supabase@2.122.0",
    "import-plan": "npm run import --workspace tools/import-plan --",
    "test:sync": "npm run test:integration --workspace packages/sync",
    "test:db": "npx --yes supabase@2.122.0 test db",
    "geocode": "npm run geocode --workspace tools/geocode --"
  },
  "engines": {
    "node": ">=22"
  }
}
